# MWAR Environment Configuration (Local-First Development)

# Dev Mode Flags
DEV_MOCK_MODE=true
NODE_ENV=development

# Cloudflare D1 & Queues & R2 (Locally Emulated via Wrangler)
CLOUDFLARE_ENV=local

# PostgreSQL 16 (Local Financial Audit Logs)
DATABASE_URL=postgresql://log_writer:local_dev_password_2026@localhost:5432/game_audit_logs
PG_HOST=localhost
PG_PORT=5432
PG_USER=log_writer
PG_PASSWORD=local_dev_password_2026
PG_DATABASE=game_audit_logs

# Redis 7 (Local Game State / Matchmaking)
REDIS_URL=redis://localhost:6379

# JWT & API Secrets
JWT_SECRET=local-dev-jwt-secret-mwar-super-safe-key-32chars
INTERNAL_API_SECRET=local-dev-internal-game-secret-2026

# External Services Mock Config
WHATSAPP_MOCK_OTP=123456
NOWPAYMENTS_API_KEY=mock_nowpayments_key_dev
NOWPAYMENTS_IPN_SECRET=mock_ipn_secret_dev
