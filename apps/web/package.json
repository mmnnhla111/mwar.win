{
  "name": "@mwar/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/check-i18n.mjs",
    "gen:stairs": "../game-server/node_modules/.bin/tsx scripts/gen-stair-data.ts",
    "test:geometry": "../game-server/node_modules/.bin/tsx --test src/game/__tests__/*.test.ts",
    "prebuild": "node scripts/check-i18n.mjs",
    "deploy:pages": "next build && wrangler pages deploy out --project-name=mwar-web --branch=main"
  },
  "dependencies": {
    "@mwar/shared": "file:../../packages/shared",
    "clsx": "^2.1.1",
    "colyseus.js": "^0.15.28",
    "lucide-react": "^0.474.0",
    "next": "15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.170.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
