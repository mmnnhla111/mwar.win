{
  "name": "mwar-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "dev:all": "concurrently -n worker,game,log,web -c cyan,magenta,yellow,blue \"pnpm dev:worker\" \"pnpm dev:game\" \"pnpm dev:log\" \"pnpm dev:web\"",
    "dev:worker": "pnpm --filter @mwar/api-worker dev",
    "dev:game": "pnpm --filter @mwar/game-server dev",
    "dev:log": "pnpm --filter @mwar/log-receiver dev",
    "dev:web": "pnpm --filter @mwar/web dev",
    "test:load-security": "node scripts/load-test/run-load-and-security-test.mjs",
    "db:migrate:local": "pnpm --filter @mwar/api-worker db:migrate:local",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "concurrently": "^10.0.7",
    "typescript": "^5.7.3"
  }
}
